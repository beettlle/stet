{
  "configVersion": 1,
  "project": {
    "name": "stet",
    "description": ""
  },
  "paths": {
    "tasksRoot": "spine-tasks"
  },
  "baseBranch": "main",
  "testing": {
    "build": "scripts/build-all.sh",
    "test": "scripts/test-all.sh",
    "testWithCoverage": "scripts/coverage-all.sh"
  },
  "agents": {
    "worker": {
      "model": "zai/glm-5.3-flash",
      "thinking": "high"
    },
    "reviewer": {
      "model": "google/gemini-3.1-pro-preview",
      "thinking": "high",
      "plan": {
        "model": "google/gemini-3.1-pro-preview",
        "thinking": "high"
      },
      "code": {
        "model": "google/gemini-3.1-pro-preview",
        "thinking": "high"
      },
      "final": {
        "model": "google/gemini-3.1-pro-preview",
        "thinking": "high"
      }
    },
    "supervisor": {
      "model": "google/gemini-3.5-flash-lite",
      "thinking": "off"
    },
    "activeProfile": "default",
    "profiles": {
      "default": {
        "worker": {
          "model": "zai/glm-5.3-flash",
          "thinking": "high"
        },
        "reviewer": {
          "model": "google/gemini-3.1-pro-preview",
          "thinking": "high",
          "plan": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "code": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "final": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          }
        },
        "supervisor": {
          "model": "google/gemini-3.5-flash-lite",
          "thinking": "off"
        }
      },
      "hard": {
        "worker": {
          "model": "zai/glm-5.3",
          "thinking": "high"
        },
        "reviewer": {
          "model": "google/gemini-3.1-pro-preview",
          "thinking": "high",
          "plan": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "code": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "final": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          }
        },
        "supervisor": {
          "model": "google/gemini-3.5-flash-lite",
          "thinking": "off"
        }
      },
      "allegretto": {
        "worker": {
          "model": "kimi-coding/k3",
          "thinking": "high"
        },
        "reviewer": {
          "model": "google/gemini-3.1-pro-preview",
          "thinking": "high",
          "plan": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "code": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          },
          "final": {
            "model": "google/gemini-3.1-pro-preview",
            "thinking": "high"
          }
        },
        "supervisor": {
          "model": "google/gemini-3.5-flash-lite",
          "thinking": "off"
        }
      }
    },
    "escalatePolicy": {
      "enabled": true,
      "toProfile": "hard"
    }
  },
  "lanes": {
    "maxParallel": 3,
    "queueExcess": true,
    "workerBackend": "subprocess",
    "workerOutputMaxBytes": 262144,
    "workerOutputTailLines": 200,
    "retainWorkerOutputOnSuccess": false,
    "streamWorkerOutputLive": false,
    "workerLiveLogMaxBytes": 262144,
    "stallTimeoutMinutes": 120,
    "stallGraceAfterProgressMinutes": 30,
    "heartbeatIntervalMinutes": 10,
    "progressSnapshotIntervalMinutes": 2,
    "checkpointWarningMinutes": 10,
    "extendGraceOnFileScope": false,
    "autoCommitOnStall": false,
    "cleanupWorktreesOnComplete": true
  },
  "dashboard": {
    "port": 8169
  },
  "gates": {
    "requireBeforeIntegrate": true,
    "collectBuildEvidence": true,
    "collectTestEvidence": true
  },
  "integrate": {
    "isolatedWorktree": true,
    "allowHumanOnBaseBranch": "warn"
  },
  "review": {
    "requireFinalVerdict": true,
    "maxFinalAttempts": 3
  },
  "handoff": {
    "path": ".spine/handoff.md",
    "autoWriteOn": [
      "session_start"
    ]
  },
  "metrics": {
    "enabled": true,
    "path": ".spine/run-metrics.jsonl"
  },
  "contract": {
    "mode": "required",
    "legacyTaskIdPrefixes": [
      "TP-"
    ]
  },
  "worktreeSetupHook": "scripts/spine-worktree-setup.sh",
  "worktreeSetupIgnorePaths": [],
  "referenceDocs": [
    "docs/constitution.md"
  ],
  "standards": [],
  "neverLoad": []
}
