# Go — binaries, test, coverage, workspace, env (see https://github.com/github/gitignore/blob/main/Go.gitignore)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Build output
bin/
dist/

# Extension (TypeScript)
extension/out/
extension/node_modules/
extension/coverage/

# Dependency directories (uncomment to ignore if you do not commit vendor)
# vendor/

# Go workspace file
go.work
go.work.sum

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# env file
.env

# Editor/IDE (uncomment to ignore; leave unignored to share .vscode/ for dev container)
.idea/
.vscode/
.cursor/
.spine/*
!.spine/spine-config.json

# Dev container: .devcontainer/ and devcontainer.json are committed.
# Add below any local devcontainer logs/cache if generated in-repo.

# Project: review worktrees (see docs/PRD.md); repo review config is committed.
.review/*
!.review/config.toml
.worktrees/

# OS
.DS_Store
Thumbs.db

# Editor backups / swap
*~
*.swp
*.swo
extension/coverage

# pi-spine runtime
.spine/runtime/
.spine/batch-state.json
.spine/batch-history.json
.spine/run-metrics.jsonl

# pi session metadata
.pi/
.pi-smart-router/state.db
.pi-smart-router/state.db-shm
.pi-smart-router/state.db-wal
.pi-smart-router/models/Xenova/all-MiniLM-L6-v2/config.json
.pi-smart-router/models/Xenova/all-MiniLM-L6-v2/tokenizer_config.json
.pi-smart-router/models/Xenova/all-MiniLM-L6-v2/tokenizer.json
.pi-smart-router/models/Xenova/all-MiniLM-L6-v2/onnx/model.onnx
