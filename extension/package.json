{
  "name": "stet",
  "displayName": "Stet",
  "description": "Local-first code review tool (Cursor)",
  "version": "0.0.1",
  "publisher": "stet",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:stet.startReview",
    "onCommand:stet.finishReview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stet.startReview",
        "title": "Stet: Start review"
      },
      {
        "command": "stet.openFinding",
        "title": "Stet: Open at location"
      },
      {
        "command": "stet.copyFindingForChat",
        "title": "Stet: Copy for Chat"
      },
      {
        "command": "stet.dismissFinding",
        "title": "Stet: Dismiss finding"
      },
      {
        "command": "stet.finishReview",
        "title": "Stet: Finish review"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stet.finishReview",
          "when": "view == stetFindings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "stet.copyFindingForChat",
          "when": "view == stetFindings && viewItem == finding",
          "group": "1_navigation"
        },
        {
          "command": "stet.dismissFinding",
          "when": "view == stetFindings && viewItem == finding",
          "group": "1_navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stet",
          "title": "Stet",
          "icon": "$(list-unordered)"
        }
      ]
    },
    "views": {
      "stet": [
        {
          "id": "stetFindings",
          "name": "Findings"
        }
      ]
    },
    "configuration": {
      "title": "Stet",
      "properties": {
        "stet.dryRun": {
          "type": "boolean",
          "default": false,
          "description": "When true, run reviews with --dry-run (skips the LLM and emits deterministic findings for development or CI). Default is false (production review)."
        },
        "stet.autoFinishZeroFindings": {
          "type": "boolean",
          "default": false,
          "description": "When true, pass --auto-finish-zero to the CLI and clear the findings panel when a review completes with zero active findings (dismissed findings do not block auto-finish). Default is false (explicit Finish required)."
        },
        "stet.minConfidence": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence (0–1) to show findings in the panel. Findings below this threshold are hidden. Default 0 shows all."
        },
        "stet.categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bug",
              "security",
              "correctness",
              "performance",
              "style",
              "maintainability",
              "best_practice",
              "testing",
              "documentation",
              "design",
              "accessibility"
            ]
          },
          "default": [],
          "description": "Category allowlist for the findings panel. Empty shows all categories."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
